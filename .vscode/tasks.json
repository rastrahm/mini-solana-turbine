{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build debug",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--bin", "mini-solana-turbine"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo test --no-run (forward_udp)",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--no-run", "--test", "forward_udp"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"]
    }
  ]
}
